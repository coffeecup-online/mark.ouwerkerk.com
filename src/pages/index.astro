---
import Header from '../components/Header.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { personal, experience, education, skills, languages, portfolio } from '../data/cv';
import '../styles/global.css';
---
<!doctype html>
<html lang="nl">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content="Maak kennis met Mark Ouwerkerk: masterstudent Artificial Intelligence aan de Universiteit Utrecht en webontwikkelaar met ervaring in automatisering." /><meta name="theme-color" content="#FAF2E6" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><title>Mark Ouwerkerk — Artificial Intelligence & Webdevelopment</title></head>
<body>
<a class="skip-link" href="#main">Ga naar de inhoud</a><Header />
<main id="main">
<section class="hero container" aria-labelledby="hero-title">
<div class="hero-copy"><p class="eyebrow">Artificial Intelligence · Webdevelopment</p><h1 id="hero-title">Mark<br /><span>Ouwerkerk</span><span class="title-dot">.</span></h1><p class="hero-description">Van slimme automatisering<br />tot doordachte websites.</p><div class="hero-actions"><a class="button" href="#ervaring">Ontdek mijn ervaring <span aria-hidden="true">↓</span></a><a class="text-link" href="/contact/">Neem contact op <span aria-hidden="true">↗</span></a></div><p class="location"><span aria-hidden="true">⌖</span> De Bilt, Nederland</p></div>
<div class="hero-bottom"><span>Nieuwsgierig naar technologie. Gericht op de praktijk.</span><a href="#ervaring">Bekijk mijn cv <span aria-hidden="true">↓</span></a></div>
</section>
<section id="ervaring" class="container cv-section section-space"><div class="cv-section-header"><SectionHeading title="CV" intro="Van webontwikkeling en automatisering tot persoonlijk klantcontact." /><a class="button cv-download" href="/CV_Mark_Ouwerkerk.pdf" download="CV_Mark_Ouwerkerk.pdf">Download CV <svg class="download-arrow" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" /></svg></a></div><div class="timeline">{experience.map(job => <article class:list={['timeline-item', { current: job.current }]}><p class="period">{job.period}{job.current && <span class="current-label">Heden</span>}</p><h3>{job.company}</h3><p class="role">{job.role}</p><ul>{job.points.map(point => <li>{point}</li>)}</ul></article>)}</div></section>
<section id="opleiding" class="education-section"><div class="container section-layout section-space"><SectionHeading title="Opleiding" intro="Een academische basis in Artificial Intelligence." /><div class="education-list">{education.map((item, index) => <article class="education-item"><span class="degree-mark" aria-hidden="true">{index === 0 ? 'MSc' : 'BSc'}</span><div><p class="period">{item.period}</p><h3>{item.degree}</h3><p class="school">{item.school}</p><p class="education-note">{item.note}</p></div></article>)}</div></div></section>
<section id="vaardigheden" class="container section-layout section-space"><SectionHeading title="Technische vaardigheden" intro="Technieken en tools waarmee ik ervaring heb." /><div class="skill-list">{skills.map(group => <div class="skill-group"><h3>{group.title}</h3><ul>{group.items.map(item => <li>{item}</li>)}</ul></div>)}</div></section>
<section id="talen" class="container section-layout languages-section"><SectionHeading title="Talen" /><div class="language-list">{languages.map(language => <div class="language"><h3>{language.name}</h3><div><p>{language.level}</p>{language.detail && <p class="language-detail">{language.detail}</p>}</div></div>)}</div></section>
<section id="portfolio" class="portfolio-section"><div class="container portfolio-layout section-space"><SectionHeading title="Portfolio" intro="Een selectie van websites die ik heb gemaakt." /><ul class="portfolio-list">{portfolio.map((website, index) => <li><a href={website.url} target="_blank" rel="noopener noreferrer"><div class="portfolio-preview"><div class="preview-toolbar" aria-hidden="true"><span></span><span></span><span></span><span class="preview-address">{website.domain}</span></div><img src={website.preview} alt={`Preview van de homepage van ${website.domain}`} width="1000" height="694" loading="lazy" decoding="async" /></div><div class="portfolio-caption"><span class="portfolio-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span class="portfolio-domain">{website.domain}</span><span class="portfolio-arrow" aria-hidden="true">↗</span></div><span class="sr-only"> (opent in een nieuw tabblad)</span></a></li>)}</ul></div></section>
<section id="contact" class="contact-section"><div class="container"><div class="contact-layout"><div><h2>Laten we<br />kennismaken<span>.</span></h2><p>Een vraag of gewoon eens van gedachten wisselen?<br />Stuur me gerust een bericht.</p><a class="button button-light" href="/contact/">Stuur een bericht <span aria-hidden="true">↗</span></a></div><address><a class="contact-email" href={`mailto:${personal.email}`}>{personal.email} <span aria-hidden="true">↗</span></a><a href={`tel:${personal.phoneHref}`}>{personal.phone}</a><a href={personal.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> (opent in een nieuw tabblad)</span></a><p>{personal.location}, Nederland</p></address></div></div></section>
</main><footer class="container footer"><p>© {new Date().getFullYear()} Mark Ouwerkerk</p><a href="#">Terug naar boven <span aria-hidden="true">↑</span></a></footer>
</body></html>









